def boot_agent(artifact_id: str, port: int, app: FastAPI, env_vars: Dict[str, str]):
    """
    Boot an Agent as a FastAPI server.
    
    Agent.run(**inputs) returns AgentResponse envelope:
      {
        "output": <result>,
        "status": "success" | "failed" | ...,
        "session_id": "<uuid>",
        "tool_calls": [...],
        "latency_ms": 123.45,
        ...
      }
    """
    agent_class = AGENTS.get(artifact_id)
    if not agent_class:
        raise ValueError(f"Agent '{artifact_id}' not found in registry")
    
    logger.info(f"Initializing agent: {artifact_id}")
    agent = agent_class(**env_vars)
    
    @app.post("/run")
    def run(body: dict):
        """Execute the agent with given inputs."""
        try:
            response = agent.run(**body)
            if isinstance(response, AgentResponse):
                return response.to_dict()
            # If user returns plain dict, wrap it
            return {
                "output": response,
                "status": "success",
                "session_id": "",
                "tool_calls": [],
                "latency_ms": 0.0,
                "error": "",
                "metadata": {},
            }
        except Exception as e:
            logger.error(f"Agent.run() failed: {e}")
            return {
                "output": None,
                "status": "failed",
                "session_id": "",
                "tool_calls": [],
                "latency_ms": 0.0,
                "error": str(e),
                "metadata": {},
            }
    
    @app.get("/health")
    def health():
        """Health check endpoint."""
        try:
            status = agent.health()
            return {"status": "ok", "agent": status}
        except Exception as e:
            return {"status": "degraded", "error": str(e)}
    
    logger.info(f"Agent '{artifact_id}' ready on port {port}")
    uvicorn.run(app, host="0.0.0.0", port=port, log_level="info")


def boot_tool(artifact_id: str, port: int, app: FastAPI, env_vars: Dict[str, str]):
    """
    Boot a Tool as a FastAPI server.
    
    Tool.run(**inputs) returns dict.
    """
    tool_class = TOOLS.get(artifact_id)
    if not tool_class:
        raise ValueError(f"Tool '{artifact_id}' not found in registry")
    
    logger.info(f"Initializing tool: {artifact_id}")
    tool = tool_class(**env_vars)
    
    @app.post("/run")
    def run(body: dict):
        """Execute the tool with given inputs."""
        try:
            result = tool.run(**body)
            return {"output": result, "status": "ok"}
        except Exception as e:
            logger.error(f"Tool.run() failed: {e}")
            return {"output": None, "status": "failed", "error": str(e)}
    
    @app.get("/health")
    def health():
        """Health check endpoint."""
        try:
            status = tool.health()
            return {"status": "ok", "tool": status}
        except Exception as e:
            return {"status": "degraded", "error": str(e)}
    
    logger.info(f"Tool '{artifact_id}' ready on port {port}")
    uvicorn.run(app, host="0.0.0.0", port=port, log_level="info")


