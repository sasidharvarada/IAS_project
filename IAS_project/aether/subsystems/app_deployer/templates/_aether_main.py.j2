def boot_model(artifact_id: str, port: int, app: FastAPI, env_vars: Dict[str, str]):
    """
    Boot a Model as a FastAPI server.
    
    Model.complete(prompt, ...) returns str (completion).
    """
    model_class = MODELS.get(artifact_id)
    if not model_class:
        raise ValueError(f"Model '{artifact_id}' not found in registry")
    
    logger.info(f"Initializing model: {artifact_id}")
    model = model_class(**env_vars)
    
    @app.post("/run")
    def run(body: dict):
        """Execute model inference."""
        try:
            prompt = body.get("prompt", "")
            system = body.get("system", "")
            result = model.complete(prompt, system=system)
            return {"output": result, "status": "ok"}
        except Exception as e:
            logger.error(f"Model.complete() failed: {e}")
            return {"output": None, "status": "failed", "error": str(e)}
    
    @app.get("/health")
    def health():
        """Health check endpoint."""
        try:
            status = model.health()
            return {"status": "ok", "model": status}
        except Exception as e:
            return {"status": "degraded", "error": str(e)}
    
    logger.info(f"Model '{artifact_id}' ready on port {port}")
    uvicorn.run(app, host="0.0.0.0", port=port, log_level="info")


# ══════════════════════════════════════════════════════════════════
#  CLI Argument Parser
# ══════════════════════════════════════════════════════════════════

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="aether-runtime",
        description="Platform-generated runtime for {{ app_id }} v{{ app_version }}",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--role",
        required=True,
        choices=["agent", "tool", "orchestrator", "model"],
        help="Which artifact type to boot",
    )
    parser.add_argument(
        "--artifact",
        required=False,
        help="Artifact ID (required for tool/orchestrator/model, optional for agent)",
    )
    parser.add_argument(
        "--port",
        type=int,
        default=8000,
        help="Port to listen on (default: 8000)",
    )
    return parser


# ══════════════════════════════════════════════════════════════════
#  Main Entry Point
# ══════════════════════════════════════════════════════════════════

def main():
    parser = build_parser()
    args = parser.parse_args()
    
    # Collect environment variables (may be used by artifact constructors)
    env_vars = dict(os.environ)
    
    # Create FastAPI app
    app = FastAPI(
        title=f"{{ app_id }} - {args.role}",
        version="{{ app_version }}",
    )
    
    @app.get("/")
    def root():
        return {
            "app": "{{ app_id }}",
            "version": "{{ app_version }}",
            "role": args.role,
            "artifact": args.artifact or "(multiple)",
        }
    
    # Boot the appropriate server
    role = args.role
    
    if role == "agent":
        artifact_id = args.artifact or "{{ default_agent_id }}"
        boot_agent(artifact_id, args.port, app, env_vars)
    
    elif role == "tool":
        if not args.artifact:
            print("ERROR: --artifact required for role=tool", file=sys.stderr)
            sys.exit(1)
        boot_tool(args.artifact, args.port, app, env_vars)
    
    elif role == "orchestrator":
        artifact_id = args.artifact or "{{ default_orchestrator_id }}"
        boot_orchestrator(artifact_id, args.port, app, env_vars)
    
    elif role == "model":
        artifact_id = args.artifact or "{{ default_model_id }}"
        boot_model(artifact_id, args.port, app, env_vars)
    
    else:
        print(f"Unknown role: {role}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
